# Copy to .env (gitignored). Never commit real values.
ELEVENLABS_API_KEY=          # https://elevenlabs.io/app/settings/api-keys (ElevenAgents, TTS, STT, Dubbing)
OPENROUTER_API_KEY=          # https://openrouter.ai/keys (independent LLM judge in evals)
TOOLS_SECRET=                # openssl rand -hex 24; ElevenLabs sends it as X-Tools-Secret
TOOLS_PORT=4700
TOOLS_HOST=                  # public host of the tools gateway, no scheme: ngrok while building, Railway in production
